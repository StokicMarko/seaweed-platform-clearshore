---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaList from '../../components/MediaList';
import { messages, toLocale } from '../../i18n';
import { getMedia } from '../../lib/api';
import type { Media } from '../../types/media';

const locale = toLocale(Astro.params.locale);
if (!locale) {
  return new Response(null, { status: 404 });
}

const t = messages[locale];

let media: Media[] = [];
let failed = false;

try {
  media = await getMedia();
} catch {
  failed = true;
}
---

<BaseLayout locale={locale} title={t.nav.media}>
  <h1>{t.nav.media}</h1>
  {failed && <p>{t.media.loadError}</p>}
  {!failed && media.length === 0 && <p>{t.media.empty}</p>}
  {media.length > 0 && <MediaList media={media} locale={locale} />}
</BaseLayout>
