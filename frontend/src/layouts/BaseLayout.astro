---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { messages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
}

const { locale, title } = Astro.props;
const t = messages[locale];
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {t.site.name}</title>
  </head>
  <body>
    <header>
      <a href={getRelativeLocaleUrl(locale)}>{t.site.name}</a>
      <nav>
        <a href={getRelativeLocaleUrl(locale)}>{t.nav.home}</a>
        <a href={getRelativeLocaleUrl(locale, 'media')}>{t.nav.media}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  img,
  video {
    max-width: 100%;
  }
</style>
