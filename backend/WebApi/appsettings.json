{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataServer": {
    "Address": "http://localhost:9090"
  },

  "MediaUpload": {
    "Rules": {
      "Image":   { "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp"], "MaxBytes": 10485760 },
      "Video":   { "AllowedExtensions": [".mp4"], "MaxBytes": 209715200 },
      "Model3D": { "AllowedExtensions": [".glb"], "MaxBytes": 52428800 }
    }
  }
}
