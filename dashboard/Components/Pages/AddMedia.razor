@page "/media/add"

@using ApiContracts.Technology
@using Dashboard.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject HttpTechnologyService TechnologyService
@inject IJSRuntime JS

@implements IAsyncDisposable

<PageTitle>Add media</PageTitle>

<main class="add-media">

    <header class="page-heading">

        <div>
            <p class="eyebrow">CONTENT OPERATIONS</p>
            <h1>Add media</h1>
        </div>

        @* Visual role selector for the prototype. *@
        <div class="role-selector">
            <label for="view-as">View as</label>

            <select id="view-as" @bind="selectedView">
                <option value="Staff Member">Staff Member</option>
                <option value="Main Admin">Main Admin</option>
            </select>
        </div>

    </header>

    <section class="media-panel">
        <h2>Media library entry</h2>

        <p>
            Choose one file and at least one technology,
            then enter all three language versions.
        </p>

        @* File selection and technologies share the same row. *@
        <div class="media-options">

            <div class="field">
                <label for="media-file">
                    Picture, video or 3D model
                </label>

                <InputFile id="media-file"
                           @ref="fileInput"
                           OnChange="OnFileSelected" />

                @* Display the selected file inside the form. *@
                @if (selectedFile is not null)
                {
                    @if (!string.IsNullOrEmpty(previewError))
                    {
                        <p role="alert">@previewError</p>
                    }
                    else if (!string.IsNullOrEmpty(previewUrl))
                    {
                        <MediaFilePreview Url="@previewUrl"
                                          ContentType="@selectedFile.ContentType"
                                          FileName="@selectedFile.Name" />
                    }

                    <small>
                        @selectedFile.Name
                        — @selectedFile.Size.ToString("N0") bytes
                    </small>
                }
            </div>

            <fieldset class="technology-section">
                <legend>Technologies</legend>

                @* Temporary example choices from the Canva template. *@
                <div class="technology-options">

                    <label class="technology-option">
                        <input type="checkbox" value="Mesh boom" />
                        Mesh boom
                    </label>

                    <label class="technology-option">
                        <input type="checkbox" value="Removal unit" />
                        Removal unit
                    </label>

                    <label class="technology-option">
                        <input type="checkbox" value="Collection system" />
                        Collection system
                    </label>

                </div>
            </fieldset>

        </div>

        @* Each language has its own title and description. *@
        <div class="language-sections">

            <fieldset class="language-section">
                <legend>English</legend>

                <div class="field">
                    <label for="title-en">Title (required)</label>
                    <input id="title-en" type="text" required />
                </div>

                <div class="field">
                    <label for="description-en">Description</label>
                    <textarea id="description-en" rows="5"></textarea>
                </div>
            </fieldset>

            <fieldset class="language-section">
                <legend>Español</legend>

                <div class="field">
                    <label for="title-es">Title (required)</label>
                    <input id="title-es" type="text" required />
                </div>

                <div class="field">
                    <label for="description-es">Description</label>
                    <textarea id="description-es" rows="5"></textarea>
                </div>
            </fieldset>

            <fieldset class="language-section">
                <legend>Français</legend>

                <div class="field">
                    <label for="title-fr">Title (required)</label>
                    <input id="title-fr" type="text" required />
                </div>

                <div class="field">
                    <label for="description-fr">Description</label>
                    <textarea id="description-fr" rows="5"></textarea>
                </div>
            </fieldset>

        </div>

        <p class="helper">
            Descriptions are optional. If you enter one,
            complete all three languages.
        </p>

        @* Submission stays disabled until validation and upload are connected. *@
        <footer class="form-actions">
            <p>
                Submitting creates a pending change request.
                Nothing is published until approval.
            </p>

            <button type="button" disabled>
                Submit change request
            </button>
        </footer>

    </section>

</main>

@code {
    // Available technologies and current selections.
    private List<TechnologyDto> technologies = new();
    private HashSet<string> selectedTechnologyTypes = new();

    private bool loadingTechnologies = true;
    private string? technologyError;

    // File metadata and the temporary browser preview.
    private InputFile? fileInput;
    private IBrowserFile? selectedFile;
    private IJSObjectReference? previewModule;

    private string previewUrl = "";
    private string? previewError;
    private string selectedView = "Staff Member";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            technologies = await TechnologyService.GetManyAsync();
        }
        catch (HttpRequestException)
        {
            technologyError =
                "Could not load technologies. Check that the API is running.";
        }
        catch (TaskCanceledException)
        {
            technologyError =
                "Loading technologies timed out. Please reload the page.";
        }
        finally
        {
            loadingTechnologies = false;
        }
    }

    // Add checked technologies and remove unchecked ones.
    private void SetTechnology(string type, bool isSelected)
    {
        if (isSelected)
        {
            selectedTechnologyTypes.Add(type);
        }
        else
        {
            selectedTechnologyTypes.Remove(type);
        }
    }

    // Create a browser preview without uploading the file.
    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        previewError = null;
        previewUrl = "";

        try
        {
            if (previewModule is null)
            {
                previewModule =
                    await JS.InvokeAsync<IJSObjectReference>(
                        "import",
                        "./js/mediaPreview.js");
            }

            previewUrl = await previewModule.InvokeAsync<string>(
                "createPreview",
                fileInput!.Element);
        }
        catch (JSException)
        {
            previewError =
                "Could not display the preview. Please select the file again.";
        }
    }

    // Release the temporary preview when leaving the page.
    public async ValueTask DisposeAsync()
    {
        if (previewModule is null)
        {
            return;
        }

        try
        {
            if (fileInput is not null)
            {
                await previewModule.InvokeVoidAsync(
                    "releasePreview",
                    fileInput.Element);
            }

            await previewModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser connection has already closed.
        }
    }
}