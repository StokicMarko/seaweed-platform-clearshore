@page "/media/add"
@namespace Dashboard.Components.Pages
@using Dashboard.Components.Pages
@using ApiContracts.ChangeRequests
@using ApiContracts.Media
@using ApiContracts.Technology
@using Dashboard.Models
@using Dashboard.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IMediaService MediaService
@inject HttpTechnologyService TechnologyService
@implements IDisposable

<PageTitle>Add media</PageTitle>

<main class="add-media">

    <header class="page-heading">
        <div>
            <p class="eyebrow">CONTENT OPERATIONS</p>
            <h1>Add media</h1>
        </div>

        @* Prototype display only; this does not change authorization. *@
        <div class="role-selector">
            <label for="view-as">View as</label>

            <select id="view-as"
                    @bind="selectedView"
                    disabled="@uploading">
                <option>Staff Member</option>
                <option>Main Admin</option>
            </select>
        </div>
    </header>

    @if (errors.Count > 0)
    {
        <div class="validation-banner" role="alert">
            <strong>
                The submission could not be completed:
            </strong>

            <ul>
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (savedRequest is not null)
    {
        <div class="validation-notice" role="status">
            <strong>
                Submitted for approval — request #@savedRequest.Id
            </strong>

            <p>
                Status: Pending. This item will appear in the media
                list only after Main Admin approval.
            </p>
        </div>
    }

    <section class="media-panel">

        <h2>Media library entry</h2>

        <p>
            Choose one file and at least one technology,
            then enter all three language versions.
        </p>

        @if (loading)
        {
            <p role="status">
                Loading technologies and upload settings...
            </p>
        }

        @if (optionsErrors.Count > 0)
        {
            <div class="options-error" role="alert">
                @foreach (var error in optionsErrors)
                {
                    <p>@error</p>
                }

                <button type="button"
                        @onclick="LoadOptionsAsync"
                        disabled="@(loading || uploading || savedRequest is not null)">
                    Reload options
                </button>
            </div>
        }

        @* Always render the form, including when API options fail. *@
        <form @onsubmit="SubmitAsync"
              @onsubmit:preventDefault
              novalidate>

            <MediaForm Data="@formData"
                       Rules="@rules"
                       Technologies="@technologies"
                       Busy="@(uploading || savedRequest is not null)"
                       FileChanged="OnFileChanged" />

            <footer class="form-actions">
                <p>
                    Submitting creates a pending change request.
                    Nothing is published until approval.
                </p>

                @if (uploading)
                {
                    <p role="status" aria-live="polite">
                        Uploading and submitting your change request.
                        Please wait...
                    </p>
                }

                <button type="submit"
                        disabled="@(uploading || loading || savedRequest is not null)">
                    @(uploading
                        ? "Uploading..."
                        : savedRequest is not null
                            ? "Submitted for approval"
                            : "Submit change request")
                </button>
            </footer>

        </form>
    </section>

</main>

@code {
    private readonly MediaFormData formData = new();
    private readonly CancellationTokenSource lifetime = new();

    private List<TechnologyDto> technologies = new();
    private List<MediaUploadRuleDto> rules = new();

    private List<string> errors = new();
    private readonly List<string> optionsErrors = new();

    private IBrowserFile? selectedFile;
    private ChangeRequestDto? savedRequest;

    private bool loading;
    private bool uploading;

    private string selectedView = "Staff Member";

    protected override Task OnInitializedAsync()
    {
        return LoadOptionsAsync();
    }

    private async Task LoadOptionsAsync()
    {
        if (loading || uploading || savedRequest is not null)
        {
            return;
        }

        loading = true;
        optionsErrors.Clear();

        try
        {
            technologies = new();
            rules = new();

            // Load technology choices.
            try
            {
                technologies =
                    (await TechnologyService.GetManyAsync(
                        lifetime.Token))
                    .Where(item =>
                        !string.IsNullOrWhiteSpace(item.Type))
                    .DistinctBy(item => item.Type)
                    .ToList();

                if (technologies.Count == 0)
                {
                    optionsErrors.Add(
                        "No technologies are available. Check the API seed data.");
                }
            }
            catch (Exception ex) when (
                ex is HttpRequestException or
                System.Text.Json.JsonException or
                TaskCanceledException)
            {
                if (!lifetime.IsCancellationRequested)
                {
                    optionsErrors.Add(
                        "Could not load technologies. Check that WebApi and Data Server are running.");
                }
            }

            if (lifetime.IsCancellationRequested)
            {
                return;
            }

            // Load formats and upload limits from the API.
            try
            {
                rules =
                    (await MediaService.GetUploadRulesAsync(
                        lifetime.Token))
                    .Where(rule =>
                        rule.MaxBytes > 0 &&
                        rule.AllowedExtensions.Count > 0)
                    .ToList();

                if (rules.Count == 0)
                {
                    optionsErrors.Add(
                        "No upload rules are configured on the API.");
                }
            }
            catch (Exception ex) when (
                ex is HttpRequestException or
                System.Text.Json.JsonException or
                TaskCanceledException)
            {
                if (!lifetime.IsCancellationRequested)
                {
                    optionsErrors.Add(
                        "Could not load upload limits. Check WebApi and the upload-rules endpoint.");
                }
            }
        }
        finally
        {
            loading = false;
        }
    }

    private void OnFileChanged(IBrowserFile? file)
    {
        selectedFile = file;
        errors.Clear();
    }

    private async Task SubmitAsync()
    {
        if (uploading ||
            savedRequest is not null ||
            lifetime.IsCancellationRequested)
        {
            return;
        }

        // Validate before opening or uploading the file.
        errors = formData.Validate(
            selectedFile?.Name,
            selectedFile?.Size ?? 0,
            rules,
            technologies.Select(item => item.Type));

        if (optionsErrors.Count > 0)
        {
            errors.Add(
                "Resolve the option-loading errors before submitting.");
        }

        if (errors.Count > 0)
        {
            return;
        }

        MediaUploadRuleDto rule = MediaFormData.FindRule(
            selectedFile!.Name,
            rules)!;

        uploading = true;

        try
        {
            MediaSubmissionResult result =
                await MediaService.AddMediaAsync(
                    formData,
                    selectedFile,
                    rule.MaxBytes,
                    lifetime.Token);

            if (result.Request is not null)
            {
                savedRequest = result.Request;
            }
            else
            {
                errors = result.Errors;
            }
        }
        catch (IOException)
        {
            errors.Add(
                "The file could not be read within its allowed size. Select it again and check the displayed limit.");
        }
        catch (Exception ex) when (
            ex is HttpRequestException or
            TaskCanceledException or
            System.Text.Json.JsonException)
        {
            if (!lifetime.IsCancellationRequested)
            {
                errors.Add(
                    "The submission could not be confirmed. Check your connection and My requests before retrying; the server may have received it.");
            }
        }
        finally
        {
            uploading = false;
        }
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
    }
}