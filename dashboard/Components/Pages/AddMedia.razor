@page "/media/add"
@namespace Dashboard.Components.Pages
@using Dashboard.Components.Pages
@using ApiContracts.ChangeRequests
@using ApiContracts.Media
@using ApiContracts.Technology
@using Dashboard.Models
@using Dashboard.Services
@using Dashboard.Services.Media
@using Microsoft.AspNetCore.Components.Forms
@inject IUploadRulesService UploadRulesService
@inject IMediaWriter MediaWriter
@inject ITechnologyService TechnologyService
@implements IDisposable

<PageTitle>Add media</PageTitle>

<main class="add-media">

    <header class="page-heading">
        <div>
            <p class="eyebrow">CONTENT OPERATIONS</p>
            <h1>Add media</h1>
        </div>

        @* Prototype display only; this does not change authorization. *@
        <div class="role-selector">
            <label for="view-as">View as</label>

            <select id="view-as"
                    @bind="selectedView"
                    disabled="@uploading">
                <option>Staff Member</option>
                <option>Main Admin</option>
            </select>
        </div>
    </header>

    <section class="media-panel">

        <h2>Media library entry</h2>

        <p>
            Choose one file and at least one technology,
            then enter all three language versions.
        </p>

        @if (loading)
        {
            <p role="status">
                Getting the form ready...
            </p>
        }

        @if (optionsErrors.Count > 0)
        {
            <div class="options-error" role="alert">
                @foreach (var error in optionsErrors)
                {
                    <p>@error</p>
                }

                <ActionButton OnClick="LoadOptionsAsync"
                              Disabled="@(loading || uploading || savedRequest is not null)">
                    Try again
                </ActionButton>
            </div>
        }

        @* Always render the form, including when API options fail. *@
        <form @onsubmit="SubmitAsync"
              @onsubmit:preventDefault
              novalidate>

            <MediaForm @key="formVersion"
                       Data="@formData"
                       FieldErrors="@fieldErrors"
                       Rules="@rules"
                       Technologies="@technologies"
                       Busy="@(uploading || savedRequest is not null)"
                       FileChanged="OnFileChanged" />

            <footer class="form-actions">
                <p>
                    Submitting creates a pending change request.
                    Nothing is published until approval.
                </p>

                @if (uploading)
                {
                    <p role="status" aria-live="polite">
                        Uploading and submitting your change request.
                        Please wait...
                    </p>
                }

                @if (errors.Count > 0)
                {
                    <StatusMessage IsError="true"
                                   Title="The submission could not be completed:"
                                   Errors="errors" />
                }

                @if (savedRequest is not null)
                {
                    <StatusMessage Title="@($"Submitted for approval — request #{savedRequest.Id}")">
                        <p>
                            Status: <StatusBadge Status="Pending" />
                            This item will appear in the media list only after
                            Main Admin approval.
                        </p>

                        <ActionButton OnClick="AddAnother">
                            Add another
                        </ActionButton>
                    </StatusMessage>
                }

                <ActionButton Type="submit"
                              Disabled="@(uploading || loading || savedRequest is not null)">
                    @(uploading
                        ? "Uploading..."
                        : savedRequest is not null
                            ? "Submitted for approval"
                            : "Submit change request")
                </ActionButton>
            </footer>

        </form>
    </section>

</main>

@code {
    private MediaFormData formData = new();
    private int formVersion;
    private readonly CancellationTokenSource lifetime = new();

    private List<TechnologyDto> technologies = new();
    private List<MediaUploadRuleDto> rules = new();

    private List<string> errors = new();
    private Dictionary<string, string> fieldErrors = new();
    private readonly List<string> optionsErrors = new();

    private IBrowserFile? selectedFile;
    private ChangeRequestDto? savedRequest;

    private bool loading;
    private bool uploading;

    private string selectedView = "Staff Member";

    protected override Task OnInitializedAsync()
    {
        return LoadOptionsAsync();
    }

    private async Task LoadOptionsAsync()
    {
        if (loading || uploading || savedRequest is not null)
        {
            return;
        }

        loading = true;
        optionsErrors.Clear();

        try
        {
            technologies = new();
            rules = new();

            // Load technology choices.
            try
            {
                technologies =
                    (await TechnologyService.GetManyAsync(
                        lifetime.Token))
                    .Where(item =>
                        !string.IsNullOrWhiteSpace(item.Type))
                    .DistinctBy(item => item.Type)
                    .ToList();

                if (technologies.Count == 0)
                {
                    optionsErrors.Add(
                        "There are no technologies to choose from yet. Please contact support.");
                }
            }
            catch (Exception ex) when (
                ex is HttpRequestException or
                System.Text.Json.JsonException or
                TaskCanceledException)
            {
                if (!lifetime.IsCancellationRequested)
                {
                    optionsErrors.Add(
                        "The list of technologies could not be loaded. Please try again in a moment.");
                }
            }

            if (lifetime.IsCancellationRequested)
            {
                return;
            }

            // Load formats and upload limits from the API.
            try
            {
                rules =
                    (await UploadRulesService.GetUploadRulesAsync(
                        lifetime.Token))
                    .Where(rule =>
                        rule.MaxBytes > 0 &&
                        rule.AllowedExtensions.Count > 0)
                    .ToList();

                if (rules.Count == 0)
                {
                    optionsErrors.Add(
                        "File uploads are not available right now. Please contact support.");
                }
            }
            catch (Exception ex) when (
                ex is HttpRequestException or
                System.Text.Json.JsonException or
                TaskCanceledException)
            {
                if (!lifetime.IsCancellationRequested)
                {
                    optionsErrors.Add(
                        "The allowed file types could not be loaded. Please try again in a moment.");
                }
            }
        }
        finally
        {
            loading = false;
        }
    }

    private void OnFileChanged(IBrowserFile? file)
    {
        selectedFile = file;
        errors.Clear();
        fieldErrors.Remove("file");
    }

    private void AddAnother()
    {
        formData = new MediaFormData();
        selectedFile = null;
        savedRequest = null;
        errors = new();
        fieldErrors = new();
        formVersion++;
    }

    private async Task SubmitAsync()
    {
        if (uploading ||
            savedRequest is not null ||
            lifetime.IsCancellationRequested)
        {
            return;
        }

        // Validate before opening or uploading the file.
        fieldErrors = formData.Validate(
            selectedFile?.Name,
            selectedFile?.Size ?? 0,
            rules,
            technologies.Select(item => item.Type));

        errors = new();

        if (optionsErrors.Count > 0)
        {
            errors.Add(
                "The form is not ready yet. Use Try again above before submitting.");
        }

        if (fieldErrors.Count > 0)
        {
            errors.Add(
                "Some details are missing or incorrect. Check the fields marked below.");
        }

        if (errors.Count > 0)
        {
            return;
        }

        MediaUploadRuleDto rule = MediaFormData.FindRule(
            selectedFile!.Name,
            rules)!;

        uploading = true;

        try
        {
            MediaSubmissionResult result =
                await MediaWriter.AddMediaAsync(
                    formData,
                    selectedFile,
                    rule.MaxBytes,
                    lifetime.Token);

            if (result.Request is not null)
            {
                savedRequest = result.Request;
            }
            else
            {
                errors = result.Errors;
            }
        }
        catch (IOException)
        {
            errors.Add(
                "The file could not be read. Choose it again and check that it is within the size limit.");
        }
        catch (Exception ex) when (
            ex is HttpRequestException or
            TaskCanceledException or
            System.Text.Json.JsonException)
        {
            if (!lifetime.IsCancellationRequested)
            {
                errors.Add(
                    "We could not confirm that your submission was saved. Check your internet connection and try again in a moment.");
            }
        }
        finally
        {
            uploading = false;
        }
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
    }
}