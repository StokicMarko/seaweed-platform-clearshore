@using System.Text.Json
@using ApiContracts.ChangeRequests
@using Dashboard.Components.Shared

<section aria-labelledby="media-request-heading">
    <h2 id="media-request-heading">Proposed media change</h2>

    @if (IsDelete)
    {
        <p>
            Delete the published media item with
            Id <strong>@Request.TargetId</strong>.
        </p>

        <p>
            The media and its file remain unchanged
            until the Main Admin approves this request.
        </p>
    }
    else if (payloadError is not null)
    {
        <StatusMessage IsError="true"
                       Title="The proposed media data could not be displayed.">
            <p>@payloadError</p>
        </StatusMessage>
    }
    else if (payload is not null)
    {
        <h3>Technologies</h3>

        <ul>
            @foreach (string type in payload.TechnologyTypes)
            {
                <li>@type</li>
            }
        </ul>

        <fieldset>
            <legend>English</legend>
            <h3>Title</h3>
            <p>@payload.Title.En</p>

            <h3>Description</h3>
            <p style="white-space: pre-wrap;">@DescriptionText(payload.Description?.En)</p>
        </fieldset>

        <fieldset>
            <legend>Español</legend>
            <h3>Title</h3>
            <p>@payload.Title.Es</p>

            <h3>Description</h3>
            <p style="white-space: pre-wrap;">@DescriptionText(payload.Description?.Es)</p>
        </fieldset>

        <fieldset>
            <legend>Français</legend>
            <h3>Title</h3>
            <p>@payload.Title.Fr</p>

            <h3>Description</h3>
            <p style="white-space: pre-wrap;">@DescriptionText(payload.Description?.Fr)</p>
        </fieldset>

        <h3>File</h3>

        @if (KeepsCurrentFile)
        {
            <p>The current media file will be kept.</p>
        }
        else
        {
            <dl>
                <dt>Original file name</dt>
                <dd>@payload.OriginalFileName</dd>

                <dt>Media type</dt>
                <dd>@payload.MediaType</dd>

                <dt>Content type</dt>
                <dd>@payload.ContentType</dd>
            </dl>

            <p>Uploaded-file preview is not available yet.</p>
        }
    }
</section>

@code {
    [Parameter, EditorRequired]
    public ChangeRequestDetailDto Request { get; set; } = default!;

    private static readonly JsonSerializerOptions JsonOptions =
        new(JsonSerializerDefaults.Web);

    private MediaPayloadDto? payload;
    private string? payloadError;

    private bool IsDelete =>
        string.Equals(
            Request.Type,
            "Delete",
            StringComparison.OrdinalIgnoreCase);

    private bool KeepsCurrentFile =>
        string.Equals(
            Request.Type,
            "Update",
            StringComparison.OrdinalIgnoreCase) &&
        payload is not null &&
        payload.MediaType is null &&
        payload.StoredFileName is null &&
        payload.OriginalFileName is null &&
        payload.ContentType is null;

    protected override void OnParametersSet()
    {
        payload = null;
        payloadError = null;

        // Delete requests do not carry the Create/Update payload.
        if (IsDelete)
        {
            return;
        }

        if (!string.Equals(
                Request.Type,
                "Create",
                StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(
                Request.Type,
                "Update",
                StringComparison.OrdinalIgnoreCase))
        {
            payloadError = "The media request type is not supported.";
            return;
        }

        if (Request.Payload is not JsonElement json ||
            json.ValueKind != JsonValueKind.Object)
        {
            payloadError = "The request has no valid media payload.";
            return;
        }

        try
        {
            payload = json.Deserialize<MediaPayloadDto>(JsonOptions);

            if (payload is null ||
                payload.Title is null ||
                payload.TechnologyTypes is null)
            {
                payload = null;
                payloadError =
                    "The media payload is missing required data.";
            }
        }
        catch (JsonException)
        {
            payloadError =
                "The media payload does not match MediaPayloadDto.";
        }
    }

    private static string DescriptionText(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "No description."
            : value;
    }
}