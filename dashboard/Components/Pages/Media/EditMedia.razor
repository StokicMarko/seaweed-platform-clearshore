@page "/media/{Id:int}/edit"
@using ApiContracts.Media
@using ApiContracts.Technology
@using Dashboard.Components.Pages
@using Dashboard.Components.Shared
@using Dashboard.Models
@using Dashboard.Services
@using Dashboard.Services.Media
@using Microsoft.AspNetCore.Components.Forms
@inject IMediaReader MediaReader
@inject ITechnologyService TechnologyService
@inject IUploadRulesService UploadRulesService
@implements IDisposable

<PageTitle>Edit media</PageTitle>

<main class="edit-media">
    <header class="page-heading">
        <p>CONTENT OPERATIONS</p>
        <h1>Edit media</h1>
        <a href="media">Back to Manage media</a>
    </header>

    @if (loading)
    {
        <p role="status">
            Loading media and form options...
        </p>
    }

    @if (errors.Count > 0)
    {
        <StatusMessage IsError="true"
                       Title="The media details could not be loaded."
                       Errors="@errors">
            <p>
                The form is displayed below, but its fields remain
                disabled until the existing media and options load.
            </p>
        </StatusMessage>

        <button type="button"
                @onclick="LoadAsync"
                disabled="@loading">
            Try again
        </button>
    }

    <section class="media-panel">
        <h2>Media library entry</h2>

        <p>
            Edit the existing language versions and technologies.
            A replacement file is optional.
        </p>

        <section class="current-file"
                 aria-labelledby="current-file-heading">
            <h3 id="current-file-heading">Current file</h3>

            @if (media is not null)
            {
                <MediaFilePreview
                    Url="@MediaReader.GetFileUrl(media)"
                    ContentType="@media.ContentType"
                    FileName="@media.FileName" />

                <p>@media.FileName</p>

                <p>
                    Keep this file by leaving the replacement
                    file selection empty.
                </p>
            }
            else
            {
                <p>
                    The current file preview will appear
                    when the media details have loaded.
                </p>
            }
        </section>

        @* Display the shared form even when loading fails. *@
        <MediaForm @key="loadVersion"
                   Data="@formData"
                   Technologies="@technologies"
                   Rules="@rules"
                   Busy="@(loading || media is null)"
                   FileChanged="OnFileChanged" />

        @if (selectedFile is not null)
        {
            <p role="status">
                Replacement selected: @selectedFile.Name.
            </p>
        }

        <StatusMessage Title="Update submission is not connected yet.">
            <p>
                Changes on this page are not saved.
                The published media remains unchanged.
            </p>
        </StatusMessage>

        <footer class="form-actions">
            <a href="media">
                Cancel and return to Manage media
            </a>
        </footer>
    </section>
</main>

@code {
    [Parameter]
    public int Id { get; set; }

    private readonly CancellationTokenSource lifetime = new();

    private MediaDto? media;
    private MediaFormData formData = new();

    private List<TechnologyDto> technologies = new();
    private List<MediaUploadRuleDto> rules = new();
    private List<string> errors = new();

    private IBrowserFile? selectedFile;
    private bool loading;
    private int loadVersion;

    protected override Task OnParametersSetAsync()
    {
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        int version = ++loadVersion;
        int requestedId = Id;

        loading = true;
        errors = new();

        // Clear the previous item so a failed load cannot show stale data.
        media = null;
        formData = new();
        technologies = new();
        rules = new();
        selectedFile = null;

        string operation = "media item";

        try
        {
            MediaDto loadedMedia = await MediaReader.GetSingleAsync(
                requestedId,
                lifetime.Token);

            operation = "technologies";

            List<TechnologyDto> loadedTechnologies =
                (await TechnologyService.GetManyAsync(lifetime.Token))
                .Where(item => !string.IsNullOrWhiteSpace(item.Type))
                .DistinctBy(item => item.Type)
                .ToList();

            operation = "upload settings";

            List<MediaUploadRuleDto> loadedRules =
                (await UploadRulesService.GetUploadRulesAsync(
                    lifetime.Token))
                .Where(rule =>
                    rule.MaxBytes > 0 &&
                    rule.AllowedExtensions.Count > 0)
                .ToList();

            // A newer navigation or retry takes precedence.
            if (version != loadVersion ||
                lifetime.IsCancellationRequested)
            {
                return;
            }

            if (loadedTechnologies.Count == 0)
            {
                errors.Add("No technologies are available.");
            }

            if (loadedRules.Count == 0)
            {
                errors.Add("No upload rules are available.");
            }

            if (errors.Count > 0)
            {
                return;
            }

            formData = new MediaFormData
            {
                TitleEn = loadedMedia.Title.En,
                TitleEs = loadedMedia.Title.Es,
                TitleFr = loadedMedia.Title.Fr,

                DescriptionEn = loadedMedia.Description?.En ?? "",
                DescriptionEs = loadedMedia.Description?.Es ?? "",
                DescriptionFr = loadedMedia.Description?.Fr ?? "",

                TechnologyTypes = loadedMedia.Technologies
                    .Select(item => item.Type)
                    .ToHashSet()
            };

            technologies = loadedTechnologies;
            rules = loadedRules;
            media = loadedMedia;
        }
        catch (OperationCanceledException)
            when (lifetime.IsCancellationRequested)
        {
            // Leaving the page cancels its requests.
        }
        catch (Exception ex) when (
            ex is HttpRequestException or
            System.Text.Json.JsonException or
            InvalidOperationException or
            OperationCanceledException)
        {
            if (version == loadVersion &&
                !lifetime.IsCancellationRequested)
            {
                // Use loading wording rather than the submission error text.
                errors = new()
                {
                    $"Could not load the {operation}. " +
                    "Check that WebApi, the Data Server and the " +
                    "database are available, then select Try again."
                };
            }
        }
        finally
        {
            if (version == loadVersion)
            {
                loading = false;
            }
        }
    }

    private void OnFileChanged(IBrowserFile? file)
    {
        selectedFile = file;
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
    }
}