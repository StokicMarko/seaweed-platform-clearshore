@page "/media"
@using ApiContracts.Media
@using Dashboard.Components.Shared
@using Dashboard.Services.Media
@inject IMediaReader MediaReader

<PageTitle>Media</PageTitle>

<h1>Media</h1>

@if (errorMessage is not null)
{
    <StatusMessage IsError="true"
                   Title="Could not load media.">
        <p>@errorMessage</p>
    </StatusMessage>
}
else if (media is null)
{
    <p role="status">Loading...</p>
}
else if (media.Count == 0)
{
    <p>No media published yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Technologies</th>
                <th scope="col">Type</th>
                <th scope="col">Title (EN)</th>
                <th scope="col">Title (ES)</th>
                <th scope="col">Title (FR)</th>
                <th scope="col">File</th>
                <th scope="col">Published</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (MediaDto item in media)
            {
                <tr @key="item.Id">
                    <td>@item.Id</td>

                    <td>
                        @string.Join(
                            ", ",
                            item.Technologies.Select(t => t.Type))
                    </td>

                    <td>@item.MediaType</td>
                    <td>@item.Title.En</td>
                    <td>@item.Title.Es</td>
                    <td>@item.Title.Fr</td>

                    <td>
                        <a href="@MediaReader.GetFileUrl(item)"
                           target="_blank"
                           rel="noopener noreferrer">
                            @item.FileName
                        </a>
                    </td>

                    <td>
                        @item.PublishedAt.ToString("yyyy-MM-dd HH:mm")
                    </td>

                    <td>
                        <a href="@($"media/{item.Id}/edit")"
                           aria-label="@($"Edit {item.Title.En}")">
                            Edit
                        </a>

                        <span aria-hidden="true"> | </span>

                        <a href="@($"media/{item.Id}/delete")"
                           aria-label="@($"Delete {item.Title.En}")">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<MediaDto>? media;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            media = await MediaReader.GetManyAsync();
        }
        catch (Exception ex) when (
            ex is HttpRequestException or
            System.Text.Json.JsonException or
            OperationCanceledException)
        {
            errorMessage = ex.Message;
        }
    }
}