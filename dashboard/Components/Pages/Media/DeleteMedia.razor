@page "/media/{Id:int}/delete"
@using ApiContracts.ChangeRequests
@using ApiContracts.Media
@using Dashboard.Components.Shared
@using Dashboard.Services.Media
@inject IMediaReader MediaReader
@inject IMediaWriter MediaWriter
@implements IDisposable

<PageTitle>Delete media</PageTitle>

<main class="delete-media">
    <header>
        <p>CONTENT OPERATIONS</p>
        <h1>Delete media</h1>
        <a href="media">Back to Manage media</a>
    </header>

    <section aria-labelledby="confirmation-heading">
        <h2 id="confirmation-heading">Confirm deletion request</h2>

        <p>
            Deletion creates a pending change request.
            The published media and its file remain available
            until the Main Admin approves the request.
        </p>

        @if (loading)
        {
            <p role="status">Loading media...</p>
        }

        @if (errorMessage is not null)
        {
            <StatusMessage IsError="true"
                           Title="The media details could not be loaded.">
                <p>@errorMessage</p>
            </StatusMessage>

            <button type="button"
                    @onclick="LoadAsync"
                    disabled="@loading">
                Try again
            </button>
        }

        @if (media is not null)
        {
            <dl>
                <dt>Id</dt>
                <dd>@media.Id</dd>

                <dt>Title (EN)</dt>
                <dd>@media.Title.En</dd>

                <dt>Title (ES)</dt>
                <dd>@media.Title.Es</dd>

                <dt>Title (FR)</dt>
                <dd>@media.Title.Fr</dd>

                <dt>Type</dt>
                <dd>@media.MediaType</dd>

                <dt>Technologies</dt>
                <dd>
                    @string.Join(
                        ", ",
                        media.Technologies.Select(item => item.Type))
                </dd>

                <dt>File</dt>
                <dd>@media.FileName</dd>
            </dl>
        }

        @if (submissionErrors.Count > 0)
        {
            <StatusMessage IsError="true"
                           Title="Could not submit the deletion request."
                           Errors="@submissionErrors" />
        }

        @if (savedRequest is not null)
        {
            <StatusMessage Title="Deletion request submitted">
                <p>Request #@savedRequest.Id is pending approval.</p>
            </StatusMessage>
        }

        <footer>
        <button type="button"
                @onclick="SubmitAsync"
                disabled="@SubmissionUnavailable">
            @(submitting ? "Submitting..." : "Submit deletion request")
        </button>
        
                    <a href="media">Back to Manage media</a>
        </footer>
    </section>
</main>

@code {
    [Parameter]
    public int Id { get; set; }

    private readonly CancellationTokenSource lifetime = new();
    private MediaDto? media;
    private string? errorMessage;
    private bool loading;
    private bool submitting;
    private ChangeRequestDto? savedRequest;
    private int loadVersion;
    private List<string> submissionErrors = new();

    private bool SubmissionUnavailable =>
        loading || submitting || media is null || savedRequest is not null;

    protected override Task OnParametersSetAsync()
    {
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        int version = ++loadVersion;
        int requestedId = Id;
        loading = true;
        submitting = false;
        savedRequest = null;
        submissionErrors.Clear();
        media = null;
        errorMessage = null;

        try
        {
            MediaDto loadedMedia = await MediaReader.GetSingleAsync(
                requestedId, lifetime.Token);

            if (version == loadVersion && !lifetime.IsCancellationRequested)
            {
                media = loadedMedia;
            }
        }
        catch (Exception ex) when (
            ex is HttpRequestException or System.Text.Json.JsonException or
            InvalidOperationException or OperationCanceledException)
        {
            if (version == loadVersion && !lifetime.IsCancellationRequested)
            {
                errorMessage =
                    "Check that WebApi, the Data Server and the " +
                    "database are available, then select Try again.";
            }
        }
        finally
        {
            if (version == loadVersion)
            {
                loading = false;
            }
        }
    }

    private async Task SubmitAsync()
    {
        if (SubmissionUnavailable || lifetime.IsCancellationRequested)
        {
            return;
        }

        int version = loadVersion;
        submissionErrors.Clear();
        submitting = true;

        try
        {
            MediaSubmissionResult result = await MediaWriter.DeleteMediaAsync(
                Id, lifetime.Token);

            if (version == loadVersion && !lifetime.IsCancellationRequested)
            {
                savedRequest = result.Request;
                submissionErrors = result.Errors;
            }
        }
        catch (Exception ex) when (
            ex is HttpRequestException or OperationCanceledException or
            System.Text.Json.JsonException)
        {
            if (version == loadVersion && !lifetime.IsCancellationRequested)
            {
                submissionErrors.Add(
                    "The submission could not be confirmed. Check My requests before retrying.");
            }
        }
        finally
        {
            if (version == loadVersion)
            {
                submitting = false;
            }
        }
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
    }
}