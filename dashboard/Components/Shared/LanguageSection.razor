<fieldset class="language-section">
    <legend>@Legend</legend>

    <FormField Id="@($"title-{Code}")"
               Label="Title (required)"
               Required="true"
               Value="@Title"
               ValueChanged="TitleChanged"
               Error="@ErrorFor("title")" />

    <FormField Id="@($"description-{Code}")"
               Label="Description (optional)"
               Required="false"
               Multiline="true"
               Value="@Description"
               ValueChanged="DescriptionChanged"
               Error="@ErrorFor("description")" />
</fieldset>

@code {
    [Parameter, EditorRequired]
    public string Legend { get; set; } = "";

    [Parameter, EditorRequired]
    public string Code { get; set; } = "";

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public EventCallback<string> TitleChanged { get; set; }

    [Parameter]
    public string Description { get; set; } = "";

    [Parameter]
    public EventCallback<string> DescriptionChanged { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, string> Errors { get; set; }
        = new Dictionary<string, string>();

    private string? ErrorFor(string field)
    {
        return Errors.TryGetValue($"{field}-{Code}", out string? message)
            ? message
            : null;
    }
}
