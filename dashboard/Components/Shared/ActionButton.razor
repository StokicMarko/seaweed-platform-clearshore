<button type="@Type"
        disabled="@Disabled"
        @onclick="OnClick">
    @ChildContent
</button>

@code {
    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
